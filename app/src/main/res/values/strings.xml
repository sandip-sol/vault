    <!-- Import -->
    <string name="import_title">Import from CSV</string>
    <string name="import_intro">Bring in passwords exported from Chrome, Bitwarden, LastPass, 1Password, Keeper or any CSV with a header row. Columns are detected automatically.</string>
    <string name="import_warning_title">Export files are plaintext</string>
    <string name="import_warning_body">A password manager export is an unencrypted list of every account you own. Keep it on this device only, and delete it as soon as the import finishes — SafeVault will remind you.</string>
    <string name="import_detected">Detected: %1$s</string>
    <string name="import_preview">First few entries</string>
    <string name="import_no_username">(no username)</string>
    <string name="import_skipped">Skipped: %1$d with no password, %2$d with no name or address.</string>
    <string name="import_adds_note">Importing adds to your vault. Nothing already stored is changed or removed, so running this twice creates duplicates.</string>
    <string name="import_unreadable">That file could not be read as a CSV export.</string>
    <string name="import_nothing_usable">No importable entries found in that file.</string>
    <string name="import_failed">Import failed: %1$s</string>
    <string name="import_cleanup_guidance">Now delete the CSV file you just imported.\n\nIt is an unencrypted copy of every password in it. Remove it from your Downloads folder, and from anywhere you copied it — email, cloud storage, or another device.\n\nIf you exported it from another password manager, empty that app\'s trash too.</string>
    <string name="import_understood">Done</string>

