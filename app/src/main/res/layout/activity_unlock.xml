<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black_pure"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="80dp"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Shield hero icon -->
        <ImageView
            android:layout_width="@dimen/icon_size_hero"
            android:layout_height="@dimen/icon_size_hero"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield" />

        <!-- App title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/unlock_vault"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:text="@string/enter_master_password"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Master password field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.SafeVault.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:hint="@string/master_password"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm password field (create mode only) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirm"
            style="@style/Widget.SafeVault.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:hint="@string/confirm_password"
            android:visibility="gone"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/on_surface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Unlock / Create button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            style="@style/Widget.SafeVault.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/unlock"
            android:textSize="16sp" />

        <!-- Biometric unlock button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBiometric"
            style="@style/Widget.SafeVault.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/use_biometric"
            android:textSize="16sp"
            android:visibility="gone"
            app:icon="@drawable/ic_fingerprint"
            app:iconGravity="textStart"
            app:iconTint="@color/primary" />

        <!-- Restore from an encrypted backup (first-run only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/restore_from_backup"
            android:textAllCaps="false"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
