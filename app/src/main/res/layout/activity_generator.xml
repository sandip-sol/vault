<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_pure"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SafeVault.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/black_pure"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/on_surface"
        app:title="@string/generator_title"
        app:titleTextColor="@color/on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Output -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SafeVault.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:minHeight="72dp"
                        android:textColor="@color/primary"
                        android:textIsSelectable="true"
                        android:textSize="19sp"
                        android:lineSpacingMultiplier="1.25" />

                    <TextView
                        android:id="@+id/tvEntropy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenerate"
                            style="@style/Widget.SafeVault.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/generator_regenerate" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopy"
                            style="@style/Widget.SafeVault.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:text="@string/generator_copy"
                            app:icon="@drawable/ic_copy"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modePassword"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/generator_mode_password" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modePassphrase"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/generator_mode_passphrase" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Password controls -->
            <LinearLayout
                android:id="@+id/passwordControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/lengthSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    app:labelBehavior="gone" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbLower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/generator_lowercase"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbUpper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/generator_uppercase"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDigits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/generator_digits"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSymbols"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/generator_symbols"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Passphrase controls -->
            <LinearLayout
                android:id="@+id/passphraseControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wordsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/wordsSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    app:labelBehavior="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SafeVault.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/generator_separator">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/separatorPicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCapitalize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/generator_capitalize"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/generator_append_number"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Session history -->
            <LinearLayout
                android:id="@+id/historySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.SafeVault.SectionHeader"
                    android:text="@string/generator_history" />

                <TextView
                    android:id="@+id/tvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_strength_pill"
                    android:fontFamily="monospace"
                    android:padding="@dimen/spacing_md"
                    android:textColor="@color/on_surface_variant"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4" />

                <TextView
                    android:id="@+id/tvHistoryNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
