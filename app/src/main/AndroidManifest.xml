<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      There is deliberately no INTERNET permission. The roadmap notes that
      INTERNET is a "normal" permission the user cannot revoke, so an in-app
      network switch is a promise rather than a control. Omitting it entirely
      makes Network Lock an OS-enforced property of the build: no dependency,
      transitively or otherwise, can open a socket.

      Adding any connected feature later means declaring it here, which is
      exactly the visible, reviewable decision it should be.
    -->

    <application
        android:name=".SafeVaultApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_vault"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeVault">

        <activity
            android:name=".ui.UnlockActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.VaultActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EntryEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SecurityActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RestoreActivity"
            android:exported="false" />

        <activity
            android:name=".ui.GeneratorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ImportActivity"
            android:exported="false" />
    </application>
</manifest>
